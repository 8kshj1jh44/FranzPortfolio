# Appwrite BaaS
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Site URL (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://franz-portfolio-psi.vercel.app

# Database & collections
APPWRITE_DATABASE_ID=portfolio_db
APPWRITE_COLLECTION_PROJECTS_ID=projects
APPWRITE_COLLECTION_AUTOMATIONS_ID=automations
APPWRITE_COLLECTION_MESSAGES_ID=contact_messages
APPWRITE_COLLECTION_ANALYTICS_ID=analytics

# Google Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Private /analytics page password
ANALYTICS_PASSWORD=

# Storage
APPWRITE_STORAGE_BUCKET_ID=portfolio_assets