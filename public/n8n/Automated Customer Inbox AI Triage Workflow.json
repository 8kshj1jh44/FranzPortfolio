      ],
      "id": "3051cc08-5f75-4758-a181-8c1823ae1a37",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $json.output || \"\";\nlet parsed = {};\n\ntry {\n  // Strip markdown code blocks if present\n  const cleanJson = rawOutput.replace(/```json/gi, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanJson);\n} catch (e) {\n  parsed = {\n    category: \"General Question\",\n    confidence_score: 50,\n    draft_response: \"Thank you for reaching out. A support agent will review your inquiry shortly.\",\n    requires_human_review: true,\n    reasoning: \"Failed to parse AI JSON response.\"\n  };\n}\n\n// Merge original input details (sender, subject, message_id) with the AI triage fields\nconst originalData = $('Code in JavaScript').first().json;\n\nreturn [{\n  json: {\n    ...originalData,\n    ...parsed\n  }\n}];"
      },
