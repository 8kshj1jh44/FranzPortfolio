      "parameters": {
        "jsCode": "// Check input items\nconst items = $input.all();\nconst processedItems = [];\n\n// Track message IDs in memory/execution\nfor (const item of items) {\n  const json = item.json.body || item.json;\n  \n  // Basic validation check\n  if (!json.body || !json.sender) {\n    throw new Error(\"Missing required fields: 'body' or 'sender' in payload.\");\n  }\n\n  // Create unique hash or ID fallback\n  const messageId = json.message_id || `msg_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;\n\n  processedItems.push({\n    json: {\n      message_id: messageId,\n      sender: json.sender,\n      subject: json.subject || \"No Subject\",\n      body: json.body,\n      received_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn processedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
