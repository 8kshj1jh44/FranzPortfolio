    {
      "parameters": {
        "jsCode": "const rawText = $json.output || $json.text || $json.response?.text || '';\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n\nlet parsed = {\n  linkedin_post: rawText,\n  twitter_thread: rawText,\n  hashtags: '#News'\n};\n\nif (jsonMatch) {\n  try {\n    parsed = JSON.parse(jsonMatch[0]);\n  } catch (e) {\n    // fallback\n  }\n}\n\n// Safely pull original title from upstream node\nconst originalTitle = $('Get row(s) in sheet')?.item?.json?.['Original Title'] \n  || $('Get row(s) in sheet')?.item?.json?.title \n  || 'Latest News';\n\nreturn {\n  json: {\n    date: new Date().toLocaleDateString('en-US'),\n    original_title: originalTitle,\n    linkedin_post: parsed.linkedin_post,\n    twitter_thread: parsed.twitter_thread,\n    hashtags: parsed.hashtags,\n    status: 'Ready for Review'\n  }\n};"
      },
