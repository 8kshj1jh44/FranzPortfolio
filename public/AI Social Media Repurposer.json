      "parameters": {
        "promptType": "define",
        "text": "=You are a viral social media strategist and ghostwriter. \nTransform the following news story / article into high-performing social media drafts for two platforms: LinkedIn and X (formerly Twitter).\n\nTitle: {{ $json['Original Title'] || $json.title }}\nSummary / Content: {{ $json['AI Summary'] || $json.contentSnippet || $json.summary }}\nLink: {{ $json['Source Link'] || $json.link }}\n\nGenerate a structured JSON output matching EXACTLY this schema (no markdown formatting, no code backticks):\n{\n  \"linkedin_post\": \"Hook on the first line.\\n\\nKey analysis in 2-3 short readable paragraphs.\\n\\nActionable takeaway or question to start a conversation in comments.\\n\\nLink placeholder: {{ $json['Source Link'] || $json.link }}\",\n  \"twitter_thread\": \"Tweet 1: Strong punchy hook with a surprising stat or takeaway.\\n\\nTweet 2: Context and details.\\n\\nTweet 3: Why it matters.\\n\\nTweet 4: Link + Question to engage followers.\",\n  \"hashtags\": \"#Tech #News #Trends\"\n}",
        "options": {}
      },
